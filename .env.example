# dev | staging | prod  (staging/prod force DEBUG=False + a real 50+ char secret + HTTPS)
DJANGO_ENV=dev
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost
# Production only, comma-separated, e.g. https://*.eraj.com
CSRF_TRUSTED_ORIGINS=
DB_NAME=eraj_platform
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=0
REDIS_URL=redis://127.0.0.1:6379/0
MODULE_PERMISSION_CACHE_TTL=180
