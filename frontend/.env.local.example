# Root domain (no protocol) where the Django backend is served.
# Local dev: Django runs on localhost:8000, tenants disambiguated via Host header.
ERAJ_BACKEND_ROOT=localhost:8000
ERAJ_BACKEND_PROTOCOL=http

# Production example (uncomment and adjust):
# ERAJ_BACKEND_ROOT=eraj.com
# ERAJ_BACKEND_PROTOCOL=https
